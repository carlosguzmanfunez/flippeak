{
  "name": "flippeak",
  "version": "0.1.0",
  "private": true,
  "description": "FlipPeak — a live marketplace for advertising attention. Position is set by Time Rate; budget only decides how long it is held.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@neondatabase/serverless": "^1.0.1",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@next/eslint-plugin-next": "^15.5.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.30.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
