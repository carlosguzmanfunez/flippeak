# ---------------------------------------------------------------------------
# FlipPeak environment template
#
# Copy to .env.local for development:   cp .env.example .env.local
# Never commit .env or .env.local. Never put real secrets in this file.
#
# Development and Preview must point at test/staging Neon branches and PayPal
# Sandbox. Never point a preview deployment at the production database.
# ---------------------------------------------------------------------------

# Public base URL of this deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# Optional in Phase 1: the foundation build runs without a database.
# Required from Phase 2 onward.
# Use the *pooled* connection string; the app uses a transaction-capable driver.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Integration tests — MANDATORY for any destructive suite.
#
# The opt-in integration tests (RUN_* flags) create and delete real rows and
# settle money. They refuse to run without this variable, and there is no
# fallback to DATABASE_URL: a shared database must never be mutated by a test.
#
# Point it at an isolated NON-PRODUCTION Neon branch (or database), never at the
# database the public deployment uses.
# ---------------------------------------------------------------------------
INTEGRATION_DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication — Phase 2. Leave empty in Phase 1.
# Generate a secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# PayPal — Phase 4. Sandbox only. Leave empty in Phase 1.
# PAYPAL_ENVIRONMENT must stay "sandbox" until production is explicitly approved.
# ---------------------------------------------------------------------------
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# QA / e2e harness credentials — used only by the standalone scripts at the
# repository root (ui-e2e.mjs, qa-ladder.mjs, qa-visual-5.mjs).
# Never commit real values: leave these empty here and fill them in .env.local.
# The password must satisfy the application's password policy.
# ---------------------------------------------------------------------------
QA_E2E_EMAIL=
QA_E2E_PASSWORD=
